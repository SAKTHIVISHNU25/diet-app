rules_version = '2';

// Meal photos.
//
// Objects live under food-images/<uid>/, and the first path segment is compared
// to the caller's uid — so a user can only read and write their own folder even
// though the bucket is shared.
//
// Note: Cloud Storage for Firebase generally requires the Blaze (pay-as-you-go)
// plan on new projects. See docs/LIMITATIONS.md — the app degrades gracefully
// if uploads fail, logging the food without a photo.
service firebase.storage {
  match /b/{bucket}/o {

    match /food-images/{userId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
