# =============================================================================
# Diet AI — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase web config (required)
#
# Firebase Console → Project settings → General → Your apps → SDK setup.
#
# These are PUBLIC by design. They identify the project and ship in client
# JavaScript; they grant no access on their own. Realtime Database Rules and
# Storage Rules are what protect your data.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef

# Realtime Database URL.
# Firebase Console → Build → Realtime Database → the URL shown at the top.
# Region matters: europe-west1 and asia-southeast1 use a different hostname
# from the default us-central1.
#   us-central1     https://your-project-default-rtdb.firebaseio.com
#   europe-west1    https://your-project-default-rtdb.europe-west1.firebasedatabase.app
#   asia-southeast1 https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# -----------------------------------------------------------------------------
# Firebase Admin SDK (required)
#
# SERVER-ONLY, and a genuine secret — unlike the values above, this grants full
# access to your project and bypasses all security rules. Never prefix it with
# NEXT_PUBLIC_ and never commit it.
#
# Firebase Console → Project settings → Service accounts → Generate new private
# key. Paste the JSON on one line, or base64-encode it (easier for Vercel,
# since the raw JSON contains newlines):
#
#   base64 -w0 service-account.json
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# -----------------------------------------------------------------------------
# USDA FoodData Central (required for nutrition lookup)
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
USDA_API_KEY=your-usda-api-key

# -----------------------------------------------------------------------------
# Food vision provider
# Which implementation of FoodVisionProvider to use.
#   huggingface — Hugging Face Inference API (needs HF_TOKEN)
#   mock        — deterministic fake results, no network, for dev and tests
# -----------------------------------------------------------------------------
FOOD_VISION_PROVIDER=huggingface

# Hugging Face access token (read scope is enough).
# https://huggingface.co/settings/tokens
# SERVER-ONLY. Required only when FOOD_VISION_PROVIDER=huggingface.
HF_TOKEN=hf_your_token

# Hugging Face image-classification model to call.
# Default is a ViT fine-tuned on Food-101 (101 single-label food classes).
# See docs/FOOD_RECOGNITION.md for limitations before changing this.
HF_FOOD_MODEL=nateraw/food

# Base URL for the Hugging Face inference endpoint. Override if you deploy the
# model to a dedicated Inference Endpoint instead of the shared serverless API.
# HF_INFERENCE_URL=https://router.huggingface.co/hf-inference/models

# -----------------------------------------------------------------------------
# Diet plan generation provider
#   template — deterministic, offline, no API key, no cost (default)
# The app is fully usable on `template`. See lib/diet/provider.ts.
# -----------------------------------------------------------------------------
DIET_PLAN_PROVIDER=template

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Canonical site URL.
# Local: http://localhost:3000 — Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
